# ============================================================
# SalesPilot AI — Environment Variables
# Copy this file to .env and fill in real values
# ============================================================

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALLOWED_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=salespilot
POSTGRES_USER=salespilot
POSTGRES_PASSWORD=salespilot_secret

DATABASE_URL=postgresql+asyncpg://salespilot:salespilot_secret@postgres:5432/salespilot

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- LLM ---
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
LLM_PROVIDER=openai          # openai | gemini
LLM_MODEL=gpt-4o-mini        # gpt-4o | gemini-1.5-pro

# --- Voice ---
# STT: openai_whisper | deepgram | assemblyai
STT_PROVIDER=openai_whisper
# TTS: openai | elevenlabs
TTS_PROVIDER=openai
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# --- RAG ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=/app/data/faiss_index
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/integrations/google/callback
GOOGLE_CALENDAR_ID=primary

# --- HubSpot CRM ---
HUBSPOT_API_KEY=
HUBSPOT_PORTAL_ID=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=salespilot@yourcompany.com

# --- Appointment defaults ---
APPOINTMENT_DURATION_MINUTES=30
APPOINTMENT_TIMEZONE=UTC

# --- Observability ---
LOG_LEVEL=INFO
SENTRY_DSN=
